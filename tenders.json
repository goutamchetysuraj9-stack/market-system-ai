// Purane fetch line ko hata kar yeh advanced fetch system daal dein:
fetch('tenders.json')
    .catch(() => fetch('/tenders.json'))
    .catch(() => fetch('./tenders.json'))
    .then(response => {
        if (!response.ok) throw new Error("Matrix File Error");
        return response.json();
    })
    .then(data => {
        tendersData = data;
        filterTenders(); // Grid render trigger hoga
    })
    .catch(err => {
        console.error("Critical routing fail on node edge:", err);
        executeFallbackUILayout();
    });
